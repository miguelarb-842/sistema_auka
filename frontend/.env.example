# URL pública usada para metadataBase y Open Graph.
# Si no se define, la aplicación usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhook del agente conversacional en n8n.
# El workflow debe aceptar { action, sessionId, chatInput } y devolver
# un JSON con el texto de la respuesta en `output` (o `text`/`response`).
N8N_CHAT_WEBHOOK_URL=https://tu-instancia.ngrok-free.dev/webhook/ID/chat

# Tiempo máximo de espera de n8n en milisegundos. Opcional.
N8N_CHAT_TIMEOUT_MS=60000
